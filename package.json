{
  "name": "moody",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:ai": "cd ai && ../.venv/Scripts/python.exe -m app.server",
    "setup": "node scripts/setup.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:schema": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-schema.ps1",
    "test:rls:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-rls-local.ps1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
