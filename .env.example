# =====================================================================
# CONNECT — environment variables
# =====================================================================
# Copy this file to ".env.local" in the project root and fill in the values.
#
#   .env.local is already ignored by Git, so your keys stay private.
#
# Where to find these values:
#   Supabase dashboard -> your project -> Settings -> API
#
# The anon key is designed to be used in the browser. Row Level Security on
# the database is what actually protects user data, so this key is safe to
# ship. NEVER put the service_role key in this file or anywhere in src/ --
# it bypasses RLS and would let anyone read every user's medical data.
# =====================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- AI backend (Baymax and Orayan) -----------------------------------
# This is the URL of the small Python service that holds the Gemini key.
# It runs on your computer with "npm run dev". Gemini is never called
# directly from the browser, so the key is never exposed.
VITE_AI_API_URL=http://127.0.0.1:8000