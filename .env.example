# =====================================================================
# CONNECT — environment variables
# =====================================================================
# Copy this file to ".env.local" in the project root and fill in the values.
#
#   .env.local is already ignored by Git, so your keys stay private.
#
# Where to find these values:
#   Supabase dashboard -> your project -> Settings -> API
#
# The anon key is designed to be used in the browser. Row Level Security on
# the database is what actually protects user data, so this key is safe to
# ship. NEVER put the service_role key in this file or anywhere in src/ --
# it bypasses RLS and would let anyone read every user's medical data.
# =====================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- AI backend (Baymax and Orayan) -----------------------------------
# The small Python service that holds the Gemini key. Gemini is never called
# from the browser, so the key is never exposed.
#
# Leave VITE_AI_BASE_URL unset. Requests then go to the same origin as the page:
# in development Vite proxies /api to http://127.0.0.1:8000, and once deployed
# Vercel serves the Python service from api/ on the same domain. Either way no
# CORS setup is needed.
#
# Set it only to point the app at a backend on a different host, which is what
# you would do if the Python service were hosted separately:
#
#   VITE_AI_BASE_URL=https://your-service.example.com
VITE_AI_BASE_URL=