ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ADAM_VOICE_ID=your_voice_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection used by the AI backend.
# Replace PASSWORD with the superuser password you chose during installation.
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/connect

# Optional: how much history to keep, per account.
# CONNECT_MAX_CONVERSATIONS=7
# CONNECT_REPORT_RETENTION_DAYS=90