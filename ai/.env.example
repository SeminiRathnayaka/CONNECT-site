ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ADAM_VOICE_ID=your_voice_id_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project. The same two values as VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY in the root .env.example.
#
# The service keeps no accounts or reports of its own, so it only needs enough
# to check that an incoming access token is real.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional but recommended. Supabase Dashboard > Settings > API > JWT Settings.
# With this the token is checked locally; without it every request asks
# Supabase instead, which works but is slower.
SUPABASE_JWT_SECRET=your_jwt_secret

# Origins allowed to call this service, comma separated. Only needed when the
# React app is not running on localhost.
# AI_ALLOWED_ORIGINS=https://your-site.example.com